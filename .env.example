# Copy to .env (never commit it). Leave a key empty if you don't have it: tools that need it
# report "skipped".
# Keep comments on their own lines: not every .env parser strips inline comments.
ANTHROPIC_API_KEY=
# Model for the agents, e.g. claude-sonnet-5-5 (T13 documents the exact format)
P2D_MODEL=
# Pricing (T16)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# Simulation (T26)
WOKWI_CLI_TOKEN=
# Video transcription (T17): whisper (local CLI) | openai | off (default)
P2D_TRANSCRIBE=
# Optional model override (defaults: base for whisper, whisper-1 for openai)
P2D_TRANSCRIBE_MODEL=
OPENAI_API_KEY=
